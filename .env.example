# ---- LLM provider (all free) --------------------------------------------
# auto = use Groq if GROQ_API_KEY is set, else local Ollama if running, else demo mode.
LLM_PROVIDER=auto

# Tools are exposed as MCP servers (mcp_servers/). Set false to call tools directly.
USE_MCP=true

# Option A: free LOCAL model via Ollama (no API key, works offline).
#   1) Install Ollama from https://ollama.com  2) run:  ollama pull llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Option B: free Groq cloud tier (fast). Get a key at https://console.groq.com/keys
# Tip: a free Groq key (Llama 3.3 70B) greatly improves international plan quality vs local llama3.2.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Search / data tools (optional; without them the agents use built-in data) ----
TAVILY_API_KEY=

# Optional - live flight schedules (free plan: https://aviationstack.com)
AVIATIONSTACK_API_KEY=

# Optional - Google Places API (New) for hotels/attractions
GOOGLE_MAPS_API_KEY=

# Optional - PostgreSQL long-term memory. If empty, in-memory storage is used.
# Example: postgresql://postgres:postgres@localhost:5432/travel_agent
DATABASE_URL=

# ---- Responsible AI (all free) ----
ENABLE_RAI=true
# auto = Llama Guard if available, else rule-based. Options: auto | llama_guard | rules
SAFETY_ENGINE=auto
# Llama Guard is optional & free: add a Groq key (uses the model below) OR run: ollama pull llama-guard3
GUARD_GROQ_MODEL=meta-llama/llama-guard-4-12b
GUARD_OLLAMA_MODEL=llama-guard3

# Orchestrator = Google ADK (free/local). In-memory sessions by default.
ADK_SQLITE_SESSIONS=

# Evaluation: include the LLM-as-judge score (1 extra model call) in the per-run score.
ENABLE_LLM_JUDGE=true
